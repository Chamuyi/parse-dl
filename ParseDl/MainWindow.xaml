<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ParseDl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ParseDl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="解析下载器"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
          官方 WinUI 3 TitleBar 控件（不是自绘）。
          出处：参照物图吧工具箱 TubaWinUi3.WinUI3/MainWindow.xaml:99 —— 它也是
          直接用 <TitleBar>，配 IconSource + IsBackButtonVisible + PaneToggleRequested。
          自绘标题栏拿不到系统级的拖拽/双击最大化/贴边分屏行为，用官方控件才有。
        -->
        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Title="解析下载器"
            FontWeight="SemiBold"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <!--
              ImageIconSource 不支持 .ico（实测：设成 .ico 后左上角什么都不显示）。
              必须用位图。这里用 48px 的方形 logo —— 标题栏图标按 16x16 逻辑像素显示，
              48px 在高 DPI 下也够清晰。
            -->
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <Grid VerticalAlignment="Center" Margin="12,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BreadcrumbText" Text="总览"
                               FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            CompactModeThresholdWidth="0"
            ExpandedModeThresholdWidth="600"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="200"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <!--
              内容区背景透明 —— 材质才能透出来。
              出处：图吧 MainWindow.xaml:280 的 NavigationViewContentBackground = Transparent。
              不设这一条时 NavigationView 会用 Mica 的实心底色把材质盖住。
            -->
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            </NavigationView.Resources>
            <!--
              NavigationView 的内容只能有一个直接子元素，所以 Frame 与
              「隐藏取址浏览器宿主」一起放进同一个 Grid。
            -->
            <Grid>
                <Frame x:Name="NavFrame" CacheSize="10" />

                <!--
                  **隐藏取址浏览器宿主**（2026-11-01）。
                  过期直链要按作品 ID 现取新地址，做法是「导航到作品页、让页面自己发请求、
                  拦截器抄响应」。不能借用解析页那个 WebView —— 用户可能正在上面滚动抓取，
                  导航走会把页面顶掉。这里给一个 1x1、全透明、不接受点击的容器：
                  肉眼看不见、也不抢焦点，但 WebView2 能正常加载与执行脚本。
                  IsHitTestVisible=False 保证它不吃鼠标；Opacity=0 不留渲染痕迹。
                -->
                <Grid x:Name="RefetchHost"
                      Width="1" Height="1"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>