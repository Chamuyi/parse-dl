<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ParseDl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ParseDl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="解析下载器"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏：48px，与 WinUI 3 TitleBarHeightOption.Tall 一致 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                        Margin="16,0,0,0" VerticalAlignment="Center">
                <Border Width="16" Height="16" CornerRadius="4"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE896;" FontSize="10"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <TextBlock x:Name="TitleText" Text="解析下载器" FontSize="12"
                           VerticalAlignment="Center" />
                <TextBlock Text="/" FontSize="12" Opacity="0.5" VerticalAlignment="Center" />
                <TextBlock x:Name="BreadcrumbText" Text="总览" FontSize="12"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            PaneDisplayMode="Top"
            SelectionChanged="NavView_SelectionChanged">
            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>
