<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ParseDl.Pages.ParsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <!--
      横向滚动必须显式关掉：WinUI 的 ScrollViewer 默认 HorizontalScrollMode=Enabled，
      会把子内容按**无限宽**测量。后果是设了 HorizontalAlignment="Left" 的面板收缩成
      自然宽度贴左边、设了 MaxWidth+Stretch 的被拉到 MaxWidth 后靠右溢出 ——
      这正是用户报的「内容怎么都在最左边」和「在最右边，还被截断了」。
      关掉横向后，外层 Grid 让内容在宽窗下**居中**、窄窗下自然占满。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled"
                  Padding="24,8,24,24">
        <Grid>
            <StackPanel x:Name="Root" Spacing="14" MaxWidth="1400"
                        HorizontalAlignment="Stretch" />
        </Grid>
    </ScrollViewer>
</Page>
