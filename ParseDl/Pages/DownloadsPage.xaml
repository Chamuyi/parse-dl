<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ParseDl.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:ParseDl.Services"
    Background="Transparent">

    <Page.Resources>
        <!--
            任务行模板。**必须有模板**：直接塞对象进 ListView 而不给 ItemTemplate，
            界面会把 ToString() 打出来（实测显示成 "ParseDl.Services.DownloadItem"）。
            行内按钮的点击在 code-behind 里按 DataContext 取回 DownloadItem。
        -->
        <DataTemplate x:Key="TaskRowTemplate" x:DataType="services:DownloadItem">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12,10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- ① 预览图：视频显示首帧，图片显示自身。占位灰底，加载失败不崩。 -->
                    <Border Grid.Column="0" Width="88" Height="88" CornerRadius="4"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                            <!-- **Uniform 而不是 UniformToFill**（2026-10-30 用户报「预览图显示不完全」）：
                                 UniformToFill 会把 96x64 框外的部分裁掉，竖图/长图只剩中间一条；
                                 改成 Uniform 保证整张图缩放进框内、四周留空但内容完整。 -->
                            <Image Stretch="Uniform"
                   Tag="{x:Bind ThumbUrl, Mode=OneWay}" Loaded="OnThumbLoaded"
                   ImageFailed="OnThumbFailed" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <!-- 文件名 -->
                        <TextBlock Text="{x:Bind FileName, Mode=OneWay}" FontSize="13"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

                        <!-- 保存位置（用户要求） -->
                        <TextBlock Text="{x:Bind DirText, Mode=OneWay}" FontSize="11" Opacity="0.55"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

                        <!-- 进度条 -->
                        <ProgressBar Value="{x:Bind Percent, Mode=OneWay}" Maximum="100" Height="4"
                                     Margin="0,2,0,2" />

                        <!-- 状态 + 错误 -->
                        <TextBlock Text="{x:Bind StatusLine, Mode=OneWay}" FontSize="11" Opacity="0.62"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

                        <!--
                          **出错时给出可手动处理的信息**（2026-11-01 用户要求：
                          「给出作者是谁，作品 id，啥的都给我，让我能手动找到尝试下载」）。
                          只在 Error 状态有文字，正常下载时这条自动隐藏。
                          用 IsTextSelectionEnabled 让用户能直接复制作品 ID 与链接。
                        -->
                        <TextBlock Text="{x:Bind FailHint, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   IsTextSelectionEnabled="True"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- ② 大小 / 速度（用户要求加速度） -->
                    <StackPanel Grid.Column="2" Spacing="2" MinWidth="120"
                                VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" FontSize="12"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{x:Bind SpeedText, Mode=OneWay}" FontSize="11" Opacity="0.6"
                                   HorizontalAlignment="Right" />
                    </StackPanel>

                    <!-- ③ 按钮组 -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                        <Button Content="{x:Bind PauseLabel, Mode=OneWay}" MinWidth="60"
                                Click="OnRowPauseClick" />
                        <Button Content="重试" MinWidth="60"
                                Visibility="{x:Bind RetryVisibility, Mode=OneWay}"
                                Click="OnRowRetryClick" />
                        <Button Content="打开文件夹" MinWidth="90"
                                Click="OnRowOpenFolderClick" />
                        <Button Content="移除" MinWidth="60"
                                Click="OnRowRemoveClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <!--
        下载管理（X / 抖音 / B 站 三模式共用本页，形态由 DownloadFeed 决定）。
        行结构：页头 / Tab 条 / 工具栏 / 任务卡（占满剩余高度）/ 历史台账。
    -->
    <Grid Padding="24,8,24,24" RowSpacing="12"
          MaxWidth="1400" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ① 页头（UiKit.PageHeader 运行时生成后塞进来） -->
        <Grid x:Name="HeaderHost" Grid.Row="0" />

        <!--
            ② Tab 条 —— 用 WinUI 官方分段控件 SelectorBar，不再自绘 Button。
            自绘 Button 塞进 Border 会被挤压：容器窄时按钮 Padding/MinWidth 收缩，
            文字被裁掉，「下载中」「错误」因此完全看不见。SelectorBar 是官方分段
            控件，自带等宽布局、选中下划线与键盘导航，六个 Tab 常驻可见。
            它单独装在一张卡片里、宽度按内容取（左对齐），不与下面的任务卡混排。
        -->
        <Border Grid.Row="1"
                HorizontalAlignment="Left"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="6,2,6,2">
            <!-- 外面再套一层横向滚动：窗口被拉窄时可横向滚，绝不挤压裁剪文字。 -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Disabled">
                <SelectorBar x:Name="TabSelector" SelectionChanged="OnTabSelectionChanged" />
            </ScrollViewer>
        </Border>

        <!-- ③ 工具栏（不在卡里）。按钮集合按模块裁剪：合并音视频只有 B 站才有； -->
        <!--    清空历史台账不在这里 —— 那是全局动作，归全局设置。 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button x:Name="RetryAllButton" Content="重试全部" MinWidth="110"
                    Visibility="Collapsed" Click="OnRetryAllClick" />
            <Button x:Name="PauseAllButton" Content="全部暂停" MinWidth="100"
                    Click="OnPauseAllClick" />
            <Button x:Name="ResumeAllButton" Content="全部继续" MinWidth="100"
                    Click="OnResumeAllClick" />
            <Button x:Name="ClearCompletedButton" Content="清除已完成" MinWidth="110"
                    Click="OnClearCompletedClick" />
            <!-- 一键清空整个下载列表（用户 2026-10-28：「怎么不能一键清空下载列表」） -->
            <Button x:Name="ClearAllButton" Content="清空列表" MinWidth="100"
                    Click="OnClearAllClick" />
            <Button x:Name="OpenDirButton" Content="打开下载目录" MinWidth="120"
                    Click="OnOpenDirClick" />
            <Button x:Name="MergeButton" Content="合并音视频" MinWidth="110"
                    Visibility="Collapsed" Click="OnMergeClick" />
            <TextBlock x:Name="ToolbarHint" VerticalAlignment="Center"
                       FontSize="12" Opacity="0.6" Margin="4,0,0,0" />
        </StackPanel>

        <!-- ④ 任务卡 -->
        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="EngineBanner" Grid.Row="0" Visibility="Collapsed"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        CornerRadius="6" Padding="12,8">
                    <TextBlock x:Name="EngineBannerText" FontSize="12.5" TextWrapping="Wrap"
                               Text="aria2 未启动，请稍候或重启应用" />
                </Border>

                <!--
                    「任务创建中」区块（对齐原项目 CreationTasks 组件）：
                    主页点「开始下载」后**立刻**在这里出现，边翻页边入队，
                    用户能实时看到「已发送 / 已跳过」在涨。只有 X 侧会显示。
                -->
                <Border x:Name="CreationCard" Grid.Row="1" Visibility="Collapsed"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6" Padding="12,10">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing IsActive="True" Width="16" Height="16"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="CreationTitle" FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="正在读取该用户的媒体并加入下载队列" FontSize="11.5"
                                           Opacity="0.55" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="取消" MinWidth="56" Padding="8,2"
                                    Click="OnCancelCreationClick" />
                        </Grid>
                        <StackPanel x:Name="CreationList" Spacing="4" />
                    </StackPanel>
                </Border>

                <!--
                    **必须用 ListView 而不是 StackPanel**（2026-10-28 修卡死）：
                    StackPanel 会把每一行都真实构建出来。378 个任务 × 每 0.8 秒清空重建一次
                    = 每次上万次控件创建，界面直接「未响应」。
                    原项目 Flutter 版用的是 ListView.separated（本身虚拟化、只构建可见项），
                    WinUI 的对应物就是 ListView —— 它自带 ItemsStackPanel 虚拟化。
                -->
                <ListView x:Name="TaskList" Grid.Row="2"
                          ContainerContentChanging="OnTaskContainerContentChanging"
                          SelectionMode="None" IsItemClickEnabled="False"
                          Padding="0" BorderThickness="0"
                          Background="Transparent"
                          ItemTemplate="{StaticResource TaskRowTemplate}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <!--
                        **清空集合变动动画**（2026-10-29 修「下载时列表一闪一闪」的真凶之三）。

                        ListView 默认的 ItemContainerTransitions 里有 AddDeleteThemeTransition /
                        RepositionThemeTransition —— 列表**每增删一行**，其余所有可见行都会播放
                        「位移 + 淡入」动画。下载时每完成一条就从「下载中」Tab 移走一行、
                        每入队一条又插一行，于是整个列表持续播放重排动画 = 肉眼看到的「一闪一闪」。

                        清空之后：增删行只是那一行消失/出现，其它行纹丝不动。
                        虚拟化由 ItemsStackPanel 负责（默认保留），不受影响。
                    -->
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection />
                    </ListView.ItemContainerTransitions>
                </ListView>

                <!--
                    空态。**必须独立于 ListView**（2026-10-28 修闪退）：
                    之前把 StackPanel 塞进 ItemsSource 当「空态行」，但 ItemTemplate
                    声明了 x:DataType="services:DownloadItem"，x:Bind 会把它 cast 成
                    DownloadItem → 抛 InvalidCastException → 整个程序闪退。
                    空态就老老实实用一个 TextBlock 叠在列表位置。
                -->
                <StackPanel x:Name="EmptyHint" Grid.Row="2" Spacing="6"
                            Visibility="Collapsed"
                            VerticalAlignment="Top" Margin="0,24,0,24">
                    <TextBlock x:Name="EmptyTitle" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyDetail" FontSize="13" Opacity="0.6"
                               TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ⑤ 历史台账板块**已按用户要求移除**（2026-10-29）：
             台账数据本身仍在 download_ledger.json 里照常记录，「跳过已下载」还要用它，
             只是不在页面上展示。 -->
    </Grid>
</Page>
