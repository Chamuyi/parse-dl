<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ParseDl.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 左侧分类栏：固定宽度，与主侧边栏（200）明显区分，不抢主栏的视觉层级 -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--
          左侧分类。
          用 ListView 而不是 NavigationView：NavigationView 自带一级导航语义（返回键、
          面包屑、层级标题），而这里是**同一页内的分类**，两层导航语义叠在一起会让人
          以为「设置」还有下一级。ListView 只有选中态，语义正好。
        -->
        <Border Grid.Column="0" Width="196" Margin="16,8,0,16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="6">
            <ListView x:Name="CategoryList"
                      SelectionMode="Single"
                      SelectionChanged="OnCategoryChanged"
                      Background="Transparent"
                      BorderThickness="0" />
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="16,8,24,24">
            <StackPanel x:Name="ContentRoot" Spacing="14" MaxWidth="900" HorizontalAlignment="Left" />
        </ScrollViewer>
    </Grid>
</Page>
