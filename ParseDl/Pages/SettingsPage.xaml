<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ParseDl.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <!--
      分类切换在**主侧边栏**（用户 2026-10-26「做成下载功能这样的点击展开」）：
      「全局设置」是可展开分组，六个分类做子项。页内没有任何分类控件。
    -->
    <Grid>
        <ScrollViewer x:Name="RootScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      Padding="24,12,24,24">
            <!--
              **居中做法（2026-10-26 第三次修正，前两次都错）**：
              前两次分别写成「Center + MaxWidth」和「Stretch + MaxWidth」，实测卡片都只有
              476px（可用宽 1223），既不居中也很空。原因不是对齐属性，而是**父级宽度不确定**：
              ScrollViewer 的 ContentPresenter 在内容自然宽度小于视口时，会把子元素的
              Stretch 退化成「按内容宽」，于是 MaxWidth 永远用不满。

              可靠做法：外层 Grid 显式绑定到 ScrollViewer 的视口宽度（Width 绑定 ActualWidth），
              这样它一定有确定宽度；内层再用 Center + MaxWidth 才真正居中。
              宽度由代码在 SizeChanged 里同步（见 SettingsPage.xaml.cs 的 SyncWidth）。
            -->
            <Grid x:Name="WidthHost" HorizontalAlignment="Left">
                <!--
                  内层同时用 **Width 绑定 + MaxWidth**：
                  Width 取 WidthHost 的实际宽度（真实数值，不依赖内容测量），
                  MaxWidth 把它封顶到 900；HorizontalAlignment=Center 让它居中。
                  这是唯一可靠的组合 —— 只写 Stretch 会退化成按内容宽（实测卡片 476px），
                  只写 Center 也会按内容宽收缩。
                -->
                <Grid HorizontalAlignment="Center" MaxWidth="900"
                      Width="{Binding ActualWidth, ElementName=WidthHost}">
                    <Grid x:Name="ContentRoot" RowSpacing="14"
                          HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
