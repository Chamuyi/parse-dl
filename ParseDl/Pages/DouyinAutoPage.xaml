<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ParseDl.Pages.DouyinAutoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <!-- 居中容器：内容 MaxWidth 1600，宽窗居中、窄窗占满（统一布局规则 lead 2026-10-25） -->
    <Grid>
    <Grid Padding="24,8,24,24" RowSpacing="12" MaxWidth="1600" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="HeaderHost" Grid.Row="0" />

        <!-- 工具栏 -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="StartButton" Grid.Column="0" Content="开始"
                        MinWidth="90" Style="{ThemeResource AccentButtonStyle}"
                        Click="OnStartClick" />
                <Button x:Name="StopButton" Grid.Column="1" Content="停止"
                        MinWidth="90" IsEnabled="False" Click="OnStopClick" />
                <Button x:Name="ClearInputButton" Grid.Column="2" Content="清空名单"
                        MinWidth="90" Click="OnClearInputClick" />
                <TextBlock x:Name="ProgressText" Grid.Column="3" Text=""
                           FontSize="13" Opacity="0.8" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!--
            主体区：按实际宽度在「左表单 + 右浏览器」与「浏览器在上 / 表单在下」之间切换
            （见 ApplyLayout）。窄窗时不再让右栏被窗口边界裁掉。
        -->
        <Grid x:Name="BodyGrid" Grid.Row="2" ColumnSpacing="12" RowSpacing="12"
              SizeChanged="OnBodyGridSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：表单（目标名单 / 跑批选项 / 任务队列 / 日志） -->
            <Border x:Name="FormCard" Grid.Row="0" Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <!--
                    关掉横向滚动是关键：ScrollViewer 默认 HorizontalScrollMode=Enabled，
                    会把子内容按无限宽测量，导致面板收缩贴左 / 被裁到右边（用户 2026-10-25 投诉）。
                -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Disabled">
                    <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                        <StackPanel x:Name="TargetCardHost" />
                        <StackPanel x:Name="OptionCardHost" />
                        <StackPanel x:Name="TaskCardHost" />
                        <StackPanel x:Name="LogCardHost" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右：内嵌浏览器 -->
            <Border x:Name="BrowserCard" Grid.Row="0" Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" MinHeight="240">
                <Grid>
                    <WebView2 x:Name="Web" />
                    <TextBlock x:Name="WebPlaceholder" Text="内嵌浏览器正在初始化…"
                               FontSize="13" Opacity="0.7" Margin="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </Grid>
</Page>
