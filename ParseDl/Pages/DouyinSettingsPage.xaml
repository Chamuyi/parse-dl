<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ParseDl.Pages.DouyinSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <!--
        统一布局规则（lead 2026-10-25）：
          1. 关掉横向滚动 —— ScrollViewer 默认 HorizontalScrollMode=Enabled 会把子内容
             按无限宽测量，于是设了 MaxWidth 的面板被拉到 MaxWidth 后靠右溢出（被截断）。
          2. 内容在宽窗下**居中**而不是贴左：外层 Grid + 根面板 HorizontalAlignment=Center，
             MaxWidth 保留。窄窗时自然占满，宽窗时居中。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled"
                  Padding="24,8,24,24">
        <Grid>
            <StackPanel x:Name="Root" Spacing="16" MaxWidth="1040"
                        HorizontalAlignment="Stretch" />
        </Grid>
    </ScrollViewer>
</Page>
