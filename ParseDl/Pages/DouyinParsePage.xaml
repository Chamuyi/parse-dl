<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ParseDl.Pages.DouyinParsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="24,8,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="HeaderHost" Grid.Row="0" />

        <!-- 地址栏与导航 -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Grid.Column="0" Content="←" MinWidth="40"
                            ToolTipService.ToolTip="后退" Click="OnBackClick" />
                    <Button x:Name="ForwardButton" Grid.Column="1" Content="→" MinWidth="40"
                            ToolTipService.ToolTip="前进" Click="OnForwardClick" />
                    <Button x:Name="ReloadButton" Grid.Column="2" Content="⟳" MinWidth="40"
                            ToolTipService.ToolTip="刷新" Click="OnReloadClick" />
                    <Button x:Name="HomeButton" Grid.Column="3" Content="首页" MinWidth="56"
                            Click="OnHomeClick" />
                    <TextBox x:Name="UrlBox" Grid.Column="4" Height="32"
                             VerticalContentAlignment="Center"
                             PlaceholderText="粘贴作品链接 / 作者主页 / 分享口令 / 纯作品 ID"
                             KeyDown="OnUrlKeyDown" />
                    <Button x:Name="GoButton" Grid.Column="5" Content="打开" MinWidth="70"
                            Click="OnGoClick" />
                    <Button x:Name="CaptureButton" Grid.Column="6" Content="抓取本页" MinWidth="90"
                            Style="{ThemeResource AccentButtonStyle}" Click="OnCaptureClick" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AutoScrollButton" Grid.Column="0" Content="自动加载"
                            MinWidth="90" Click="OnAutoScrollClick" />
                    <Button x:Name="DiagnoseButton" Grid.Column="1" Content="诊断"
                            MinWidth="70" Click="OnDiagnoseClick" />
                    <TextBlock x:Name="StatusText" Grid.Column="2" Text="" FontSize="12"
                               Opacity="0.75" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- 左：内嵌浏览器 -->
            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <WebView2 x:Name="Web" />
                    <TextBlock x:Name="WebPlaceholder" Text="内嵌浏览器正在初始化…"
                               FontSize="13" Opacity="0.7" Margin="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- 右：下载选项 + 结果列表 -->
            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="OptionHost" Grid.Row="0" Spacing="6" />

                    <Grid Grid.Row="1" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SelectAllButton" Grid.Column="0" Content="全选"
                                MinWidth="60" Click="OnSelectAllClick" />
                        <Button x:Name="SelectNoneButton" Grid.Column="1" Content="清空勾选"
                                MinWidth="80" Click="OnSelectNoneClick" />
                        <Button x:Name="SelectVideoButton" Grid.Column="2" Content="选全部视频"
                                MinWidth="92" Click="OnSelectVideoClick" />
                        <Button x:Name="SelectImageButton" Grid.Column="3" Content="选全部图文"
                                MinWidth="92" Click="OnSelectImageClick" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
                                    HorizontalAlignment="Right">
                            <Button x:Name="FilterButton" Content="筛选" MinWidth="60"
                                    Click="OnFilterClick" />
                            <Button x:Name="ClearButton" Content="清空" MinWidth="60"
                                    Click="OnClearClick" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="ListSummary" Grid.Row="2" Text="" FontSize="12"
                               Opacity="0.7" TextWrapping="Wrap" />

                    <ListView x:Name="ResultList" Grid.Row="3"
                              SelectionMode="None" IsItemClickEnabled="False"
                              BorderThickness="0" Padding="0" />

                    <Grid Grid.Row="4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DownloadSummary" Grid.Column="0" Text=""
                                   FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button x:Name="DownloadButton" Grid.Column="1" Content="开始下载"
                                MinWidth="120" Style="{ThemeResource AccentButtonStyle}"
                                Click="OnDownloadClick" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
