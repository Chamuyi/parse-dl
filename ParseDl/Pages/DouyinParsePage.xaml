<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ParseDl.Pages.DouyinParsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <!--
        统一布局规则（lead 2026-10-25）：外层 Grid 做居中容器，内容 MaxWidth 1600
        并在宽窗下居中、窄窗下自然占满。本页顶层不是 ScrollViewer（内容自己管滚动），
        但仍要避免超宽屏下无限拉伸。
    -->
    <Grid>
    <Grid Padding="24,8,24,24" RowSpacing="12" MaxWidth="1600" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="HeaderHost" Grid.Row="0" />

        <!-- 地址栏与导航 -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Grid.Column="0" Content="←" MinWidth="40"
                            ToolTipService.ToolTip="后退" Click="OnBackClick" />
                    <Button x:Name="ForwardButton" Grid.Column="1" Content="→" MinWidth="40"
                            ToolTipService.ToolTip="前进" Click="OnForwardClick" />
                    <Button x:Name="ReloadButton" Grid.Column="2" Content="⟳" MinWidth="40"
                            ToolTipService.ToolTip="刷新" Click="OnReloadClick" />
                    <Button x:Name="HomeButton" Grid.Column="3" Content="首页" MinWidth="56"
                            Click="OnHomeClick" />
                    <TextBox x:Name="UrlBox" Grid.Column="4" Height="32"
                             VerticalContentAlignment="Center"
                             PlaceholderText="粘贴作品链接 / 作者主页 / 分享口令 / 纯作品 ID"
                             KeyDown="OnUrlKeyDown" />
                    <Button x:Name="GoButton" Grid.Column="5" Content="打开" MinWidth="70"
                            Click="OnGoClick" />
                    <Button x:Name="CaptureButton" Grid.Column="6" Content="抓取本页" MinWidth="90"
                            Style="{ThemeResource AccentButtonStyle}" Click="OnCaptureClick" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AutoScrollButton" Grid.Column="0" Content="自动加载"
                            MinWidth="90" Click="OnAutoScrollClick" />
                    <Button x:Name="DiagnoseButton" Grid.Column="1" Content="诊断"
                            MinWidth="70" Click="OnDiagnoseClick" />
                    <TextBlock x:Name="StatusText" Grid.Column="2" Text="" FontSize="12"
                               Opacity="0.75" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!--
            主体区：**布局由代码按实际宽度切换**（见 ApplyLayout）。
              宽（>= 820）：左浏览器 / 右抓取面板，两列各 *，右列 MinWidth 380；
              窄（< 820）：改成上下两行，右栏移到浏览器下方 —— 这样右栏内容
                            永远不会被窗口右边界裁掉（用户 2026-10-25 报的截断问题）。
            两个卡片都挂在本 Grid 上，靠 Grid.Row / Grid.Column 换位。
        -->
        <Grid x:Name="BodyGrid" Grid.Row="2" ColumnSpacing="12" RowSpacing="12"
              SizeChanged="OnBodyGridSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--
              **左右比例 3:2**（用户 2026-10-26：「Web 有点小，右侧抓取太大了」）。
              原来是 1:1 —— 抖音网页在窄栏里只露出中间一小块，而右栏选项区本来就撑不满、留白多。
              左边是干活主区（浏览、滚动、点作品），右边只是选项 + 结果网格。
              用星号比例而不是固定像素，窄窗时两边一起缩，不会把右栏挤没。
            -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- 左：内嵌浏览器 -->
            <Border x:Name="BrowserCard" Grid.Row="0" Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" MinHeight="240">
                <Grid>
                    <WebView2 x:Name="Web" />
                    <TextBlock x:Name="WebPlaceholder" Text="内嵌浏览器正在初始化…"
                               FontSize="13" Opacity="0.7" Margin="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- 右：下载选项 + 抓取结果网格 -->
            <Border x:Name="CaptureCard" Grid.Row="0" Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 下载选项（代码生成，两个下拉同宽同高同基线） -->
                    <StackPanel x:Name="OptionHost" Grid.Row="0" Spacing="8" />

                    <!-- 全选 + 已选计数 -->
                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="SelectAllBox" Grid.Column="0" Content="全选" MinWidth="0"
                                  IsThreeState="True" Click="OnSelectAllBoxClick" />
                        <TextBlock x:Name="SelectedCountText" Grid.Column="1" Text="已选 0"
                                   FontSize="12" Opacity="0.7"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 操作按钮排：自己写的换行面板，宽度不够时自动换行（不再被截断） -->
                    <Grid x:Name="ActionHost" Grid.Row="2" />

                    <TextBlock x:Name="ListSummary" Grid.Row="3" Text="" FontSize="12"
                               Opacity="0.7" TextWrapping="Wrap" />

                    <!-- 抓取结果：方格缩略图网格（点击格子放大预览） -->
                    <GridView x:Name="ResultGrid" Grid.Row="4"
                              SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="OnTileClick"
                              BorderThickness="0" Padding="0"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="3" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            </Style>
                        </GridView.ItemContainerStyle>
                    </GridView>

                    <Grid Grid.Row="5" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DownloadSummary" Grid.Column="0" Text=""
                                   FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button x:Name="DownloadButton" Grid.Column="1" Content="开始下载"
                                MinWidth="120" Style="{ThemeResource AccentButtonStyle}"
                                Click="OnDownloadClick" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </Grid>
</Page>
