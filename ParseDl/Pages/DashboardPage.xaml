<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ParseDl.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,8,24,24">
        <StackPanel Spacing="16" MaxWidth="1400" HorizontalAlignment="Stretch">

            <!-- 页头：28px 标题 + 14px 副题 + 48×48 图标块 -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="8"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        VerticalAlignment="Top">
                    <FontIcon Glyph="&#xE80F;" FontSize="22"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="2">
                    <TextBlock Text="总览" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="总览 · 快捷入口 · 最近活动" FontSize="14" Opacity="0.7" />
                </StackPanel>
            </Grid>

            <!-- 主卡片：产品名 + 状态 + 版本 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="8"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE896;" FontSize="26"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="解析下载器" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="批量下载 X、抖音与 B 站上的图片与视频" FontSize="13" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                CornerRadius="12" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="下载引擎就绪" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                CornerRadius="12" Padding="10,4">
                            <TextBlock Text="v1.3" FontSize="12" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4 个统计卡 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="进行中" FontSize="12" Opacity="0.6" />
                        <TextBlock x:Name="RunningCount" Text="0" FontSize="24" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="已完成" FontSize="12" Opacity="0.6" />
                        <TextBlock x:Name="DoneCount" Text="0" FontSize="24" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="下载台账" FontSize="12" Opacity="0.6" />
                        <TextBlock x:Name="LedgerCount" Text="0" FontSize="24" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="磁盘占用" FontSize="12" Opacity="0.6" />
                        <TextBlock x:Name="DiskUsage" Text="0 B" FontSize="24" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 快捷开始 6 卡 -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="快捷开始" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="点一下直达" FontSize="12" Opacity="0.6"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl x:Name="QuickGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="模块状态" FontSize="16" FontWeight="SemiBold" />
                            <Grid>
                                <TextBlock Text="X 下载" FontSize="13" />
                                <TextBlock Text="0 / 0" FontSize="13" HorizontalAlignment="Right" Opacity="0.7" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="抖音解析下载" FontSize="13" />
                                <TextBlock Text="0 / 0" FontSize="13" HorizontalAlignment="Right" Opacity="0.7" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="B 站下载" FontSize="13" />
                                <TextBlock Text="0 / 0" FontSize="13" HorizontalAlignment="Right" Opacity="0.7" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="下载引擎" FontSize="16" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE73E;" FontSize="12"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="aria2 正在运行" FontSize="13" />
                            </StackPanel>
                            <Grid>
                                <TextBlock Text="正在下载" FontSize="13" Opacity="0.7" />
                                <TextBlock Text="0" FontSize="13" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="任务总数" FontSize="13" Opacity="0.7" />
                                <TextBlock Text="0" FontSize="13" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="环境" FontSize="16" FontWeight="SemiBold" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="数据目录" FontSize="13" Opacity="0.7" />
                                <TextBlock x:Name="DataDirText" Text="-" FontSize="12"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 最近活动 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="最近活动" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="来自下载任务" FontSize="12" Opacity="0.6"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="还没有下载任务" FontSize="13" Opacity="0.6" Margin="0,8,0,8" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
